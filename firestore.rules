rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. 기존 daily_fundamentals 읽기 허용
    match /daily_fundamentals/{document=**} {
      allow read: if true;
    }
    // 2. target_stocks (종목추가용 API) 쓰기 허용
    match /target_stocks/{document=**} {
      allow read, write: if true;
    }
  }
}
